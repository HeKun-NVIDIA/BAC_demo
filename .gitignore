# Whitelist: only the project source is committed (the same set embedded in
# install.sh). Models, runtimes, workspace, logs and the gateway token are
# created on each Spark by install.sh.
/*
!/.gitignore
!/VERSION
!/README.md
!/MANUAL_TEST.md
!/PROMPTS.txt
!/env.sh
!/reset.sh
!/stop.sh
!/status.sh
!/uninstall.sh
!/install.sh
!/install.sh.sha256
!/scripts/
!/manifests/

!/artifacts/
/artifacts/*
!/artifacts/container/

!/openclaw/
/openclaw/*
!/openclaw/bin/
!/openclaw/config/
!/openclaw/plugins/
!/openclaw/tools/
!/openclaw/workspace-template/
!/openclaw/demo-templates/
!/openclaw/package.json
!/openclaw/package-lock.json

!/services/
/services/*
!/services/tts/

!/showcase/
/showcase/*
!/showcase/server.py

!/docs/
/docs/*
!/docs/MODEL_DOWNLOAD_CN.md
!/docs/THIRD_PARTY.md
!/docs/bacdemolist.pptx

__pycache__/
*.pyc
*.partial
